# No FetchContent, download or other build-time network operation.
option(LIBRELOOP_BUILD_DESKTOP "Build the LibreLoop desktop application" ON)
option(LIBRELOOP_USE_SYSTEM_SDL "Use an installed SDL3 SDK instead of the pinned source" OFF)
option(LIBRELOOP_VALIDATE_SYSTEM_SDL "Compatibility alias for LIBRELOOP_USE_SYSTEM_SDL" OFF)
if(LIBRELOOP_VALIDATE_SYSTEM_SDL)
  set(LIBRELOOP_USE_SYSTEM_SDL ON)
endif()
option(LIBRELOOP_EXPERIMENT_SHARED_SDL "Experiment only: shared vendored SDL instead of static" OFF)
set(LIBRELOOP_SDL_AVAILABLE OFF)
set(LIBRELOOP_SDL_IS_SHARED OFF)
set(LIBRELOOP_SDL_TARGET SDL3::SDL3)
set(_sdl_pin_file "${CMAKE_CURRENT_LIST_DIR}/../third_party/sdl-source.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_sdl_pin_file}")
file(READ "${_sdl_pin_file}" _sdl_pin)
string(JSON _pinned_version GET "${_sdl_pin}" version)
string(JSON _pinned_archive GET "${_sdl_pin}" archive_sha256)
if(LIBRELOOP_BUILD_DESKTOP)
  if(LIBRELOOP_USE_SYSTEM_SDL)
    find_package(SDL3 3.4 CONFIG REQUIRED)
    if(TARGET SDL3::SDL3-shared)
      set(LIBRELOOP_SDL_TARGET SDL3::SDL3-shared)
      set(LIBRELOOP_SDL_IS_SHARED ON)
    elseif(TARGET SDL3::SDL3-static)
      set(LIBRELOOP_SDL_TARGET SDL3::SDL3-static)
    else()
      message(FATAL_ERROR "SDL3 SDK has neither a shared nor static library target")
    endif()
  elseif(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/SDL/CMakeLists.txt")
    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/SDL/libreloop-source.json")
      message(FATAL_ERROR "SDL source provenance missing; use tools/vendor_sdl.py with the pinned archive")
    endif()
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/third_party/SDL/libreloop-source.json" _provenance)
    string(JSON _version GET "${_provenance}" version)
    string(JSON _archive GET "${_provenance}" archive_sha256)
    if(NOT _version STREQUAL _pinned_version OR NOT _archive STREQUAL _pinned_archive)
      message(FATAL_ERROR "Unexpected SDL source provenance")
    endif()
    if(LIBRELOOP_EXPERIMENT_SHARED_SDL)
      set(SDL_SHARED ON CACHE BOOL "" FORCE)
      set(SDL_STATIC OFF CACHE BOOL "" FORCE)
      set(LIBRELOOP_SDL_IS_SHARED ON)
    else()
      set(SDL_SHARED OFF CACHE BOOL "" FORCE)
      set(SDL_STATIC ON CACHE BOOL "" FORCE)
    endif()
    set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
    set(SDL_TESTS OFF CACHE BOOL "" FORCE)
    add_subdirectory(third_party/SDL EXCLUDE_FROM_ALL)
    if(LIBRELOOP_EXPERIMENT_SHARED_SDL)
      set(LIBRELOOP_SDL_TARGET SDL3::SDL3-shared)
    else()
      set(LIBRELOOP_SDL_TARGET SDL3::SDL3-static)
    endif()
    if(NOT LIBRELOOP_EXPERIMENT_SHARED_SDL AND NOT TARGET SDL3::SDL3-static)
      message(FATAL_ERROR "Vendored static SDL target unavailable")
    endif()
  else()
    message(FATAL_ERROR "Desktop build needs third_party/SDL. Run python3 tools/build.py to prepare and build it, or import the pinned SDL ${_pinned_version} archive with tools/vendor_sdl.py (see docs/building.md). An installed SDL >= 3.4 SDK can be selected with -DLIBRELOOP_USE_SYSTEM_SDL=ON. For core-only builds set -DLIBRELOOP_BUILD_DESKTOP=OFF.")
  endif()
  set(LIBRELOOP_SDL_AVAILABLE ON)
endif()
