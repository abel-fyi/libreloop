# Explicit Phase5 candidates only. Empty flags/OFF keep normal builds unchanged.
set(LIBRELOOP_EXPERIMENT_ENGINE_OPT "" CACHE STRING "Experiment: engine/audio O2 or O3")
set(LIBRELOOP_EXPERIMENT_UI_OPT "" CACHE STRING "Experiment: UI/glue O3 or Os")
option(LIBRELOOP_EXPERIMENT_LTO "Experiment: interprocedural optimization" OFF)
set_property(CACHE LIBRELOOP_EXPERIMENT_ENGINE_OPT PROPERTY STRINGS "" O2 O3)
set_property(CACHE LIBRELOOP_EXPERIMENT_UI_OPT PROPERTY STRINGS "" O3 Os)
if(LIBRELOOP_EXPERIMENT_ENGINE_OPT OR LIBRELOOP_EXPERIMENT_UI_OPT OR LIBRELOOP_EXPERIMENT_LTO)
  if(NOT CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
    message(FATAL_ERROR "These experiment flags are defined for Clang/GCC; other toolchains need separate measurements")
  endif()
  if(NOT LIBRELOOP_EXPERIMENT_ENGINE_OPT MATCHES "^(|O2|O3)$" OR NOT LIBRELOOP_EXPERIMENT_UI_OPT MATCHES "^(|O3|Os)$")
    message(FATAL_ERROR "Unsupported experiment optimization value")
  endif()
  set(engine_targets engine audio benchmark_engine benchmark_capture feature_capture callback_capture callback_realtime_audit)
  set(ui_targets interaction windows utf8 platform_files midi_input font_raster text_fonts theme widget_pixels
    input_sdl draw_sdl window_sdl thread_sdl sampler_service ui_render piano_draw waveform_draw controls_draw editor_draw
    frontend_host libreloop)
  foreach(target IN LISTS engine_targets)
    if(TARGET ${target} AND LIBRELOOP_EXPERIMENT_ENGINE_OPT)
      target_compile_options(${target} PRIVATE "-${LIBRELOOP_EXPERIMENT_ENGINE_OPT}")
    endif()
  endforeach()
  foreach(target IN LISTS ui_targets)
    if(TARGET ${target} AND LIBRELOOP_EXPERIMENT_UI_OPT)
      target_compile_options(${target} PRIVATE "-${LIBRELOOP_EXPERIMENT_UI_OPT}")
    endif()
  endforeach()
  if(LIBRELOOP_EXPERIMENT_LTO)
    # Whole-project try_compile must use the same SDK as the real build.
    # Older policy defaults otherwise silently select this host's broken SDK27.
    if(POLICY CMP0137)
      cmake_policy(SET CMP0137 NEW)
    endif()
    list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
      CMAKE_OSX_SYSROOT CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_ARCHITECTURES)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT supported OUTPUT reason LANGUAGES C)
    if(NOT supported)
      message(FATAL_ERROR "LTO experiment unavailable: ${reason}")
    endif()
    get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
      get_target_property(kind ${target} TYPE)
      if(kind MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|EXECUTABLE)$")
        set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
      endif()
    endforeach()
  endif()
endif()
